# VeteranDesk Environment Configuration
ENVIRONMENT=development
SESSION_ID=dev_session_1

# Database Configuration (PostgreSQL / Supabase)
# If SUPABASE_DB_URL is empty, SQLite local fallback is used for offline testing: sqlite+aiosqlite:///./veterandesk.db
DATABASE_URL=sqlite+aiosqlite:///./veterandesk.db
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# SUPABASE_KEY=your-anon-or-service-role-key
# SUPABASE_URL=https://your-ref.supabase.co

# Market Data (DPS Scraper)
DPS_BASE_URL=https://dps.psx.com.pk
SCRAPE_INTERVAL_SECONDS=30
WATCHLIST=["OGDC", "PPL", "ENGRO", "LUCK", "HUBC", "MCB", "UBL", "HBL", "EFERT", "FFC", "TRG", "SYS", "DGKC", "MLCF", "PSO"]

# Risk & Discipline Engine (Hard Rules)
STARTING_BALANCE_PKR=500000.0
MAX_RISK_PER_TRADE_PCT=1.00
MAX_DAILY_LOSS_PCT=2.00
MAX_INTRADAY_TRADES_PER_DAY=3
ENTRY_CUTOFF_TIME_PKT=15:00:00
FORCE_CLOSE_TIME_PKT=15:20:00
MAX_ADV_PERCENTAGE=5.00

# Reasoning & Post-Mortem (Claude API or Groq Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# Optional Groq fallback if budget is free-only:
GROQ_API_KEY=
USE_MOCK_LLM_IF_NO_KEY=true

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Discord Webhook API
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false

# System Monitoring
HEARTBEAT_INTERVAL_SECONDS=60
MAX_MISSED_HEARTBEAT_SECONDS=120
LATENCY_ALERT_THRESHOLD_SECONDS=90
